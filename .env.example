# ============================================================
# ENV FRONTEND (Vite)
#
# Vite HANYA mengekspos variabel berawalan VITE_ ke browser.
# Variabel tanpa prefix VITE_ TIDAK akan terbaca oleh kode client.
#
# ⚠️ Nilai VITE_* di-INLINE saat BUILD, bukan dibaca saat runtime.
#    Setelah mengubah file .env WAJIB build ulang:
#      bun run build   (lalu pm2 restart)
#    Restart saja TIDAK cukup.
#
# Salin file ini jadi ".env" lalu isi nilainya.
# ============================================================

# URL base backend API
VITE_API_URL="https://api.teranet.web.id"

# URL publik aplikasi ini (dipakai untuk link pembayaran di pesan WhatsApp
# ketika di-render di server / SSR)
VITE_APP_URL="https://teranet.web.id"

VITE_APP_NAME="Teranet Bill"


# ------------------------------------------------------------
# MIDTRANS
#
# Mode ditentukan di DUA sisi dan keduanya harus SAMA:
#   1. FRONTEND → VITE_MIDTRANS_CLIENT_KEY (di file ini)
#   2. BACKEND  → MIDTRANS_SERVER_KEY + isProduction
#
# Kalau backend masih pakai SERVER KEY sandbox, transaksi TETAP sandbox
# walaupun frontend sudah production. Jadi kalau pembayaran "masih test",
# cek server key di backend lebih dulu.
#
# Ambil key di: https://dashboard.midtrans.com → Settings → Access Keys
# (pilih environment Production, bukan Sandbox, di pojok kiri atas)
# ------------------------------------------------------------

# --- PRODUCTION (uang sungguhan) ---
# Client key production TIDAK punya prefix "SB-"
VITE_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxx"
VITE_MIDTRANS_ENV="production"

# --- SANDBOX (uji coba, uang tidak berpindah) ---
# VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
# VITE_MIDTRANS_ENV="sandbox"
